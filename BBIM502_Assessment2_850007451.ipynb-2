{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0362da6f-4a25-464a-968b-e45db390b212",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "********************************************\n",
      "       LANGHAM HOTEL MANAGEMENT SYSTEM\n",
      "********************************************\n",
      "1. Add Rooms\n",
      "2. Delete Rooms\n",
      "3. Display Room Details\n",
      "4. Allocate Rooms\n",
      "5. Display Room Allocation Details\n",
      "6. Billing and De-Allocation\n",
      "7. Save Room Allocation to File\n",
      "8. Display Room Allocation from File\n",
      "9. Backup and Clear Room Allocation File\n",
      "0. Exit Application\n",
      "********************************************\n"
     ]
    }
   ],
   "source": [
    "# File Name: BBIM502_Assessment2_850014319\n",
    "# Author: Aariz Gafoor Ali\n",
    "# Description: Langham Hotel Management System for managing rooms, customer allocations, billing, and file handling.\n",
    "# Date: 04/11/2026\n",
    "\n",
    "# Importing the required modules\n",
    "try:\n",
    "    import datetime\n",
    "    import os\n",
    "except ImportError:\n",
    "    # Catching ImportError when a required module cannot be imported\n",
    "    print(\"Error: Required module could not be imported.\")\n",
    "    raise\n",
    "\n",
    "# Creating empty lists to store rooms and room allocations\n",
    "list_of_rooms = []\n",
    "list_of_room_allocations = []\n",
    "\n",
    "\n",
    "# 1. Function for adding rooms\n",
    "def add_rooms():\n",
    "    #This function allows me to add new rooms to the hotel.\n",
    "    try:\n",
    "        count = int(input(\"How many rooms do you want to add: \"))\n",
    "\n",
    "       \n",
    "        if count <= 0:\n",
    "            print(\"Please enter a number greater than zero.\")\n",
    "            return\n",
    "\n",
    "        for i in range(count):\n",
    "            print(\"\\nEntering details for Room\", i + 1)\n",
    "            room_no = int(input(\"Enter Room Number: \"))\n",
    "           \n",
    "            room = {\"room_no\": room_no, \"is_allocated\": False}\n",
    "            list_of_rooms.append(room)\n",
    "            print(\"Room added successfully.\")\n",
    "\n",
    "        print(\"\\nRoom operation completed.\")\n",
    "\n",
    "    except ValueError:\n",
    "        # Catching ValueError when text or an invalid number is entered\n",
    "        print(\"Error: Please enter valid numeric values.\")\n",
    "    except TypeError:\n",
    "        # Catching TypeError when an operation receives an incorrect data type\n",
    "        print(\"Error: Incorrect data type entered.\")\n",
    "    except EOFError:\n",
    "        # Catching EOFError when input ends unexpectedly\n",
    "        print(\"Error: No input received.\")\n",
    "\n",
    "\n",
    "# 2. Function for deleting rooms\n",
    "def delete_rooms():\n",
    "   # This function allows me to delete rooms that are not allocated.\n",
    "    if len(list_of_rooms) == 0:\n",
    "        print(\"No rooms have been added yet.\")\n",
    "        return\n",
    "\n",
    "    try:\n",
    "        room_no = int(input(\"Enter the room number to delete: \"))\n",
    "        room_found = False\n",
    "\n",
    "        for room in list_of_rooms:\n",
    "            if room[\"room_no\"] == room_no:\n",
    "                room_found = True\n",
    "               \n",
    "                list_of_rooms.remove(room)\n",
    "                print(\"Room deleted successfully.\")\n",
    "                break\n",
    "\n",
    "        if not room_found:\n",
    "            print(\"Room number not found.\")\n",
    "\n",
    "    except ValueError:\n",
    "        # Catching ValueError when the room number is not numeric\n",
    "        print(\"Error: Please enter a numeric room number.\")\n",
    "    except EOFError:\n",
    "        # Catching EOFError when input ends unexpectedly\n",
    "        print(\"Error: No input received.\")\n",
    "\n",
    "\n",
    "# 3. Function for displaying room details\n",
    "def display_rooms():\n",
    "    #This function displays all rooms and their current status.\n",
    "    if len(list_of_rooms) == 0:\n",
    "        print(\"No rooms have been added yet.\")\n",
    "        return\n",
    "\n",
    "    print(\"\\n----- LIST OF ROOMS -----\")\n",
    "    try:        \n",
    "        for index in range(len(list_of_rooms)):\n",
    "            room = list_of_rooms[index]\n",
    "            print(\"Room Number:\", room[\"room_no\"])\n",
    "            print(\"Room Status:\", \"Allocated\" if room[\"is_allocated\"] else \"Available\")\n",
    "            print(\"-------------------------\")\n",
    "\n",
    "    except IndexError:\n",
    "        # Catching IndexError if a list position is no longer available\n",
    "        print(\"Error: Room list position was not found.\")\n",
    "    except TypeError:\n",
    "        # Catching TypeError if room information has an incorrect type\n",
    "        print(\"Error: Incorrect room data type.\")\n",
    "\n",
    "\n",
    "# 4. Function for allocating rooms\n",
    "def allocate_rooms():\n",
    "    #This function allows me to allocate an available room to a customer.\n",
    "    if len(list_of_rooms) == 0:\n",
    "        print(\"No rooms have been added yet.\")\n",
    "        return\n",
    "\n",
    "    try:\n",
    "        room_no = int(input(\"Enter the room number to allocate: \"))\n",
    "        room_found = False\n",
    "\n",
    "        for room in list_of_rooms:\n",
    "            if room[\"room_no\"] == room_no:\n",
    "                room_found = True\n",
    "               \n",
    "                customer_no = int(input(\"Enter Customer Number: \"))\n",
    "                customer_name = input(\"Enter Customer Name: \")\n",
    "                nights = int(input(\"Enter Number of Nights: \"))\n",
    "               \n",
    "                allocation = {\n",
    "                    \"room_no\": room_no,\n",
    "                    \"customer_no\": customer_no,\n",
    "                    \"customer_name\": customer_name,\n",
    "                    \"nights\": nights,\n",
    "                    \"date\": datetime.datetime.now()\n",
    "                }\n",
    "\n",
    "                list_of_room_allocations.append(allocation)\n",
    "                room[\"is_allocated\"] = True\n",
    "                print(\"Room allocated successfully to\", customer_name)\n",
    "                break\n",
    "\n",
    "       \n",
    "    except ValueError:\n",
    "        # Catching ValueError when numeric input is invalid\n",
    "        print(\"Error: Please enter valid numeric values.\")\n",
    "    except TypeError:\n",
    "        # Catching TypeError when data types are incompatible\n",
    "        print(\"Error: Incorrect data type entered.\")\n",
    "    except EOFError:\n",
    "        # Catching EOFError when input ends unexpectedly\n",
    "        print(\"Error: No input received.\")\n",
    "\n",
    "\n",
    "# 5. Function for displaying room allocation details\n",
    "def display_room_allocations():\n",
    "    #This function displays details of currently allocated rooms.\n",
    "    if len(list_of_room_allocations) == 0:\n",
    "        print(\"No rooms are currently allocated.\")\n",
    "        return\n",
    "\n",
    "    print(\"\\n----- ROOM ALLOCATION DETAILS -----\")\n",
    "    for allocation in list_of_room_allocations:\n",
    "        print(\"Room Number:\", allocation[\"room_no\"])\n",
    "        print(\"Customer Number:\", allocation[\"customer_no\"])\n",
    "        print(\"Customer Name:\", allocation[\"customer_name\"])\n",
    "        print(\"Number of Nights:\", allocation[\"nights\"])\n",
    "        print(\"Allocation Date:\", allocation[\"date\"])\n",
    "        print(\"-----------------------------------\")\n",
    "\n",
    "\n",
    "# 6. Function for billing and de-allocation\n",
    "def billing_and_deallocation():\n",
    "    #This function calculates the bill and releases the room. Price is $100 per night.\n",
    "    if len(list_of_room_allocations) == 0:\n",
    "        print(\"No room allocations exist.\")\n",
    "        return\n",
    "\n",
    "    try:\n",
    "        room_no = int(input(\"Enter room number for billing: \"))\n",
    "        allocation_found = False\n",
    "\n",
    "        for allocation in list_of_room_allocations:\n",
    "            if allocation[\"room_no\"] == room_no:\n",
    "                allocation_found = True\n",
    "                price_per_night = 100\n",
    "                nights = allocation[\"nights\"]\n",
    "                \n",
    "                try:\n",
    "                    total_bill = price_per_night * nights\n",
    "                    average_rate = total_bill / nights\n",
    "                except ZeroDivisionError:\n",
    "                    # Catching ZeroDivisionError if nights is zero\n",
    "                    print(\"Error: Cannot calculate a bill for zero nights.\")\n",
    "                    return\n",
    "\n",
    "                # Catching OverflowError if a very large calculation exceeds float limits\n",
    "                try:\n",
    "                    checked_total = float(total_bill)\n",
    "                except OverflowError:\n",
    "                    print(\"Error: The bill amount is too large to calculate.\")\n",
    "                    return\n",
    "\n",
    "                print(\"\\n========== HOTEL BILL ==========\")\n",
    "                print(\"Customer Number:\", allocation[\"customer_no\"])\n",
    "                print(\"Customer Name:\", allocation[\"customer_name\"])\n",
    "                print(\"Room Number:\", allocation[\"room_no\"])\n",
    "                print(\"Check-in Date:\", allocation[\"date\"])\n",
    "                checkout_date = datetime.datetime.now()\n",
    "                print(\"Check-out Date:\", checkout_date)\n",
    "                print(\"Number of Nights:\", nights)\n",
    "                print(\"Price Per Night: $\", price_per_night)\n",
    "                print(\"Total Bill: $\", checked_total)\n",
    "                print(\"Average Rate: $\", average_rate)\n",
    "                print(\"================================\")\n",
    "\n",
    "                list_of_room_allocations.remove(allocation)\n",
    "\n",
    "                # Returning the room to available status after billing               \n",
    "                for room in list_of_rooms:\n",
    "                    if room[\"room_no\"] == room_no:\n",
    "                        room[\"is_allocated\"] = False\n",
    "                        break\n",
    "\n",
    "                print(\"Room successfully de-allocated.\")\n",
    "                break\n",
    "        \n",
    "        if not allocation_found:\n",
    "            print(\"No allocation found for this room.\")\n",
    "\n",
    "    except ValueError:\n",
    "        # Catching ValueError when the entered room number is not numeric\n",
    "        print(\"Error: Please enter a numeric room number.\")\n",
    "    except TypeError:\n",
    "        # Catching TypeError when billing data has an incompatible type\n",
    "        print(\"Error: Incorrect data type entered.\")\n",
    "    except EOFError:\n",
    "        # Catching EOFError when input ends unexpectedly\n",
    "        print(\"Error: No input received.\")\n",
    "\n",
    "\n",
    "# 7. Function for saving room allocations to a file\n",
    "def save_room_allocations():\n",
    "    #This function saves room allocation details to a text file.\n",
    "    filename = \"LHMS_850007451.txt\"\n",
    "\n",
    "    try:\n",
    "        file = open(filename, \"w\")\n",
    "        for allocation in list_of_room_allocations:\n",
    "            file.write(\"Room Number: \" + str(allocation[\"room_no\"]) + \"\\n\")\n",
    "            file.write(\"Customer Number: \" + str(allocation[\"customer_no\"]) + \"\\n\")\n",
    "            file.write(\"Customer Name: \" + allocation[\"customer_name\"] + \"\\n\")\n",
    "            file.write(\"Number of Nights: \" + str(allocation[\"nights\"]) + \"\\n\")\n",
    "            file.write(\"Allocation Date: \" + str(allocation[\"date\"]) + \"\\n\")\n",
    "            file.write(\"-----------------------------------\\n\")\n",
    "        file.close()\n",
    "        print(\"Room allocations saved to file successfully.\")\n",
    "\n",
    "    except IOError:\n",
    "        # Catching IOError when a file cannot be opened, written, or closed\n",
    "        print(\"Error: Unable to perform file input/output operation.\")\n",
    "    except TypeError:\n",
    "        # Catching TypeError if file content has an incompatible data type\n",
    "        print(\"Error: Incorrect data type when writing to file.\")\n",
    "\n",
    "\n",
    "# 8. Function for displaying room allocations from a file\n",
    "def display_room_allocations_from_file():\n",
    "    #This function reads allocation details from a text file.\n",
    "    filename = \"LHMS_850007451.txt\"\n",
    "\n",
    "    try:\n",
    "        file = open(filename, \"r\")\n",
    "        content = file.read()\n",
    "        print(\"\\n----- ROOM ALLOCATIONS FROM FILE -----\")\n",
    "        print(content)\n",
    "        file.close()\n",
    "\n",
    "    except FileNotFoundError:\n",
    "        # Catching FileNotFoundError when the requested file does not exist\n",
    "        print(\"Error: File not found. Please save allocations first.\")\n",
    "    except IOError:\n",
    "        # Catching IOError for other file reading problems\n",
    "        print(\"Error: Unable to read the file.\")\n",
    "    except TypeError:\n",
    "        # Catching TypeError if file content is not the expected type\n",
    "        print(\"Error: Incorrect data type when reading the file.\")\n",
    "\n",
    "\n",
    "# 9. Function for backing up and clearing room allocation file\n",
    "def backup_and_clear_room_allocations():\n",
    "    #This function backs up the allocation file and clears the original.\n",
    "    filename = \"LHMS_850007451.txt\"\n",
    "    current_datetime = datetime.datetime.now()\n",
    "    backup_filename = (\n",
    "        \"LHMS_850007451_Backup_\"\n",
    "        + current_datetime.strftime(\"%Y-%m-%d_%H-%M-%S\")\n",
    "        + \".txt\"\n",
    "    )\n",
    "\n",
    "    try:\n",
    "        file = open(filename, \"r\")\n",
    "        content = file.read()\n",
    "        file.close()\n",
    "\n",
    "        backup_file = open(backup_filename, \"a\")\n",
    "        backup_file.write(content)\n",
    "        backup_file.close()\n",
    "\n",
    "        file = open(filename, \"w\")\n",
    "        file.close()\n",
    "\n",
    "        print(\"Backup created successfully.\")\n",
    "        print(\"Room allocation file cleared successfully.\")\n",
    "\n",
    "    except FileNotFoundError:\n",
    "        # Catching FileNotFoundError when the original allocation file is missing\n",
    "        print(\"Error: Allocation file not found. Save allocations first.\")\n",
    "    except IOError:\n",
    "        # Catching IOError during file backup, reading, writing, or clearing\n",
    "        print(\"Error: Unable to perform file operation.\")\n",
    "    except TypeError:\n",
    "        # Catching TypeError if file data is an incorrect type\n",
    "        print(\"Error: Incorrect data type during file operation.\")\n",
    "\n",
    "\n",
    "# 10. Function for exiting the application\n",
    "def exit_application():\n",
    "    #This function displays a message when the user exits.\n",
    "    print(\"Exiting the application. Goodbye!\")\n",
    "\n",
    "\n",
    "# Main function for displaying the menu\n",
    "def main():\n",
    "   #This function displays the menu and calls the selected option.\n",
    "    while True:\n",
    "        print(\"\\n********************************************\")\n",
    "        print(\"       LANGHAM HOTEL MANAGEMENT SYSTEM\")\n",
    "        print(\"********************************************\")\n",
    "        print(\"1. Add Rooms\")\n",
    "        print(\"2. Delete Rooms\")\n",
    "        print(\"3. Display Room Details\")\n",
    "        print(\"4. Allocate Rooms\")\n",
    "        print(\"5. Display Room Allocation Details\")\n",
    "        print(\"6. Billing and De-Allocation\")\n",
    "        print(\"7. Save Room Allocation to File\")\n",
    "        print(\"8. Display Room Allocation from File\")\n",
    "        print(\"9. Backup and Clear Room Allocation File\")\n",
    "        print(\"0. Exit Application\")\n",
    "        print(\"********************************************\")\n",
    "\n",
    "        try:\n",
    "            choice = input(\"Enter Your Choice Number Here: \")\n",
    "        # Catching EOFError when menu input ends unexpectedly\n",
    "        except EOFError:\n",
    "            print(\"Error: Input ended unexpectedly. Exiting application.\")\n",
    "            break\n",
    "\n",
    "        try:\n",
    "            if choice == \"1\":\n",
    "                add_rooms()\n",
    "            elif choice == \"2\":\n",
    "                delete_rooms()\n",
    "            elif choice == \"3\":\n",
    "                display_rooms()\n",
    "            elif choice == \"4\":\n",
    "                allocate_rooms()\n",
    "            elif choice == \"5\":\n",
    "                display_room_allocations()\n",
    "            elif choice == \"6\":\n",
    "                billing_and_deallocation()\n",
    "            elif choice == \"7\":\n",
    "                save_room_allocations()\n",
    "            elif choice == \"8\":\n",
    "                display_room_allocations_from_file()\n",
    "            elif choice == \"9\":\n",
    "                backup_and_clear_room_allocations()\n",
    "            elif choice == \"0\":\n",
    "                exit_application()\n",
    "                break\n",
    "            else:\n",
    "                print(\"Invalid choice! Please select a number from 0 to 9.\")\n",
    "\n",
    "        # Catching NameError if a variable name is accidentally undefined during execution\n",
    "        except NameError:\n",
    "            print(\"Error: A variable name was not defined correctly.\")\n",
    "        # Catching SyntaxError from dynamically compiled Python code\n",
    "        except SyntaxError:\n",
    "            print(\"Error: A syntax problem was detected.\")\n",
    "        # Catching TypeError for incompatible types passed during menu operations\n",
    "        except TypeError:\n",
    "            print(\"Error: An operation used an incorrect data type.\")\n",
    "\n",
    "\n",
    "# Calling the main function to start the program\n",
    "if __name__ == \"__main__\":\n",
    "    main()\n"
   ]
  },
